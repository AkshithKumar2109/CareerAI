
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"   android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CareerAI"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#2457C5"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI-Based Resume Analyzer &amp; Career Guidance"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#263238"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze your resume, discover your skills, and find the skills you need for your target career."
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="#607080"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Your Target Career"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerCareerRole"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#2457C5"
            android:entries="@array/career_roles"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnAnalyzeResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze Resume"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnCareerGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Career Guidance"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analysis History"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build your skills. Improve your resume. Grow your career."
            android:textSize="13sp"
            android:textColor="#607080"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>

